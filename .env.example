# Copy this file to .env for local development.
# The application imports .env when it exists.
# In production, prefer a system or process environment variable.
# Use a cryptographically random value at least 32 bytes long.
JWT_SECRET=
SPRING_PROFILES_ACTIVE=local

# Keep 127.0.0.1 for direct deployment behind Nginx.
# Override with 0.0.0.0 only when another container must reach this server.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# PostgreSQL containers use separate databases, ports, credentials, and volumes.
# Set a non-empty password for each PostgreSQL profile that you run.
# The active PostgreSQL container rejects an empty password before DB initialization.
LOCAL_POSTGRES_DB=community
LOCAL_POSTGRES_USER=community_local
LOCAL_POSTGRES_PASSWORD=
LOCAL_POSTGRES_PORT=5432

BENCHMARK_POSTGRES_DB=community_benchmark
BENCHMARK_POSTGRES_USER=community_benchmark
BENCHMARK_POSTGRES_PASSWORD=
BENCHMARK_POSTGRES_PORT=5433

# Use an absolute path in production.
UPLOAD_PATH=./uploads

# CORS is disabled by default in production because Nginx provides one origin.
# For an exceptional cross-origin deployment, set app.cors.allowed-origins explicitly.
# .env example: app.cors.allowed-origins=https://frontend.example.com
# Process environment example: APP_CORS_ALLOWED_ORIGINS=https://frontend.example.com
